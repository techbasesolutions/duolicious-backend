# Ahavah backend — production environment variables.
# Copy to `.env.production` and fill in real values. Never commit `.env.production`.

# ----- Security-critical (REQUIRED — compose fails loudly if blank) --------
# Postgres superuser password. Used as the docker-bridge auth for postgres,
# api, chat, and cron containers. Generate with `openssl rand -base64 32`.
POSTGRES_PASSWORD=
# HMAC signing key for session tokens. If blank, every issued bearer is
# signable by anyone (catastrophic). 32+ random chars: `openssl rand -hex 32`.
SESSION_TOKEN_SECRET=

# ----- DigitalOcean Spaces (photo storage) ---------------------------------
DUO_R2_BUCKET_NAME=ahavah-photos-prod
DUO_R2_AUDIO_BUCKET_NAME=ahavah-photos-prod
DUO_R2_ACCT_ID=
DUO_R2_ACCESS_KEY_ID=
DUO_R2_ACCESS_KEY_SECRET=
DUO_BOTO_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com

# ----- Resend SMTP (transactional email) -----------------------------------
DUO_SMTP_HOST=smtp.resend.com
DUO_SMTP_PORT=587
DUO_SMTP_USER=resend
# REQUIRED — Resend API key (compose fails loudly if blank).
DUO_SMTP_PASS=
# When true, sends via Resend HTTPS API instead of SMTP relay (more reliable
# behind Cloudflare; smtp.resend.com TLS is fingerprinted by Cloudflare).
DUO_USE_RESEND_API=true
# Override the From address on every Resend send. UNSET IN PRODUCTION — if
# set in prod, every welcome/OTP mail goes from this address instead of
# branded ahavah.app and immediately tanks domain reputation. Used only
# for the Phase-W bridge period when no DNS was live for ahavah.app.
DUO_RESEND_FROM_OVERRIDE=

# Firehol IP blocklist. Default-enabled; set true to disable (NEVER in prod).
DUO_DISABLE_FIREHOL=false

# Redis password. Unused today (the upstream codebase instantiates
# redis.Redis() without a password kwarg), but referenced in compose for
# future-proofing. Safe to leave blank — redis isn't reachable from the
# public internet (port unbound in production override).
REDIS_PASSWORD=

# ----- Web Push (VAPID) ----------------------------------------------------
# Generate with `openssl ecparam -name prime256v1 -genkey -noout -out
# vapid_private.pem && openssl ec -in vapid_private.pem -pubout -out
# vapid_public.pem` then base64url-encode the raw key bytes.
# If blank, PUSH_ENABLED short-circuits to false in
# service/notifications/__init__.py — no crash, push just doesn't send.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ahavah.app

# Comma + space separated; per-recipient relay weights from upstream behaviour.
# Format: "addr1 weight1 addr2 weight2 ..." per service/cron/profilereporter.
DUO_REPORT_EMAIL=ahavah@example.com 20 a@example.com 0

# ----- Branded URLs (consumed by service/config.py) ------------------------
# No domain registered yet; using droplet IP for staging. Swap to
# https://api.ahavah.app etc. when domain lands.
AHAVAH_API_BASE_URL=
AHAVAH_WEB_BASE_URL=
AHAVAH_EMAIL_ASSETS_BASE_URL=
AHAVAH_USER_IMAGES_BASE_URL=
AHAVAH_XMPP_DOMAIN=ahavah.app
AHAVAH_PRODUCT_NAME=Ahavah
AHAVAH_EMAIL_DOMAIN=ahavah.app

# ----- CORS (Vercel preview + prod hosts) ----------------------------------
# Comma-separated explicit allowlist. NEVER leave as `*` in production —
# wildcard CORS lets any third-party site read JSON responses from this API.
DUO_CORS_ORIGINS=https://ahavah.app,https://www.ahavah.app

# ----- Cloudflare Turnstile (bot mitigation on public POSTs) ---------------
# When set, the backend verifies a Turnstile token on /request-otp,
# /waitlist, and /beta-tester. When blank/unset, verification is a no-op
# (honeypot still active) — flip the env vars to activate without code
# changes. Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# (free, unlimited, WCAG 2.1 AAA accessible). The site key is also baked
# into the frontend as NEXT_PUBLIC_TURNSTILE_SITE_KEY in Vercel.
TURNSTILE_SECRET_KEY=

# ----- Cron tuning ---------------------------------------------------------
DUO_CRON_PROFILE_REPORTER_POLL_SECONDS=60
DUO_CRON_EMAIL_POLL_SECONDS=30
DUO_CRON_AUTODEACTIVATE2_DRY_RUN=false
DUO_CRON_AUTODEACTIVATE2_POLL_SECONDS=300
DUO_CRON_INSERT_LAST_POLL_SECONDS=10
DUO_CRON_PHOTO_CLEANER_DRY_RUN=false
DUO_CRON_PHOTO_CLEANER_POLL_SECONDS=300
DUO_CRON_AUDIO_CLEANER_DRY_RUN=false
DUO_CRON_AUDIO_CLEANER_POLL_SECONDS=300
DUO_CRON_GARBAGE_RECORDS_POLL_SECONDS=300
DUO_CRON_MAX_RANDOM_START_DELAY=60

# ----- Chat -----------------------------------------------------------------
DUO_CHAT_PORTS=5443

# ----- Optional integrations (set when ready; service no-ops if unset) -----
OPENAI_API_KEY=
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ----- Stripe (deferred to Cutover C.2/C.3) --------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_IDENTITY=
STRIPE_WEBHOOK_SECRET_CHECKOUT=

# Stripe Prices for premium subscription tiers (Phase W).
STRIPE_PRICE_PREMIUM_MONTH=
STRIPE_PRICE_PREMIUM_QUARTER=
STRIPE_PRICE_PREMIUM_YEAR=

# Stripe Prices for token-bundle one-shot purchases (Phase 2 token economy).
# Four SKUs map 1:1 to dashboard Products. Webhook discriminates by
# session.metadata.sku and credits token_ledger accordingly.
STRIPE_PRICE_TOKENS_SINGLE=
STRIPE_PRICE_TOKENS_STARTER=
STRIPE_PRICE_TOKENS_PLUS=
STRIPE_PRICE_TOKENS_PRO=

# ----- Twilio (deferred until SMS OTP is needed) ---------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ----- Verification mock (used when OPENAI_API_KEY unset) ------------------
DUO_VERIFICATION_IMAGE_BASE_URL=http://localhost:5000
DUO_VERIFICATION_MOCK_RESPONSE_FILE=test/input/verification-mock-response-file
